  "guide": [
    {
      "title": "Pemberi dan penerima hibah",
      "paragraphs": [
        "Isi identitas sesuai dokumen resmi. Bagian identitas badan hanya diisi apabila pihak yang memberikan hibah merupakan badan."
      ]
    },
    {
      "title": "Data objek hibah",
      "paragraphs": [
        "Periksa kembali NOP, NIB, alamat objek, luas tanah, luas bangunan, dan nilai pengalihan sebelum mencetak."
      ]
    },
    {
      "title": "Penandatanganan",
      "paragraphs": [
        "Nama penandatangan mengikuti nama pemberi hibah secara otomatis, tetapi tetap dapat diubah bila diperlukan."
      ]
    }
  ]
