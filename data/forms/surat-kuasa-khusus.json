{
  "schemaVersion": 1,
  "id": "surat-kuasa-khusus",
  "type": "letter",
  "renderer": "kuasa-classic",
  "title": "Surat Kuasa Khusus Wajib Pajak",
  "description": "Formulir Kabayan untuk membuat Surat Kuasa Khusus dalam bentuk kertas, lengkap dengan status pemberi kuasa, jenis kuasa, ruang lingkup, masa berlaku, dan area meterai.",
  "notice": "Format mengikuti Lampiran Huruf A PMK Nomor 44 Tahun 2026. Satu Surat Kuasa Khusus hanya berlaku untuk satu orang kuasa dan ruang lingkup perpajakan tertentu.",
  "output": {
    "method": "browser-print",
    "pageSize": "A4",
    "orientation": "portrait"
  },
  "legacyUrls": [
    "surat-kuasa-khusus-wajib-pajak.html"
  ],
  "formTitleChoice": {
    "prefix": "SURAT KUASA KHUSUS WAJIB PAJAK",
    "id": "jenisWp",
    "label": "Jenis Wajib Pajak",
    "required": true,
    "options": [
      { "value": "BADAN", "label": "BADAN" },
      { "value": "ORANG PRIBADI", "label": "ORANG PRIBADI" },
      { "value": "WARISAN BELUM TERBAGI", "label": "WARISAN BELUM TERBAGI" }
    ],
    "placeholder": "PILIH JENIS WAJIB PAJAK"
  },
  "blocks": [
    {
      "type": "inline-fields",
      "layout": "subtitle",
      "fields": [
        {
          "id": "nomor",
          "label": "Nomor",
          "validationLabel": "Nomor surat",
          "type": "text",
          "required": true
        },
        {
          "id": "tanggal",
          "label": "Tanggal",
          "validationLabel": "Tanggal surat",
          "type": "date",
          "required": true
        }
      ]
    },
    {
      "type": "paragraph",
      "variant": "section",
      "text": "Yang bertanda tangan di bawah ini:"
    },
    {
      "type": "fields",
      "fields": [
        {
          "id": "namaPemberi",
          "label": "nama",
          "validationLabel": "Nama pemberi kuasa",
          "type": "text",
          "required": true
        },
        {
          "id": "npwpPemberi",
          "label": "NPWP",
          "validationLabel": "NPWP pemberi kuasa",
          "type": "npwp",
          "placeholder": "16 digit NPWP",
          "required": true
        },
        {
          "id": "jabatanPemberi",
          "label": "jabatan",
          "type": "text"
        }
      ]
    },
    {
      "type": "radio",
      "name": "statusPemberi",
      "label": "bertindak selaku: *)",
      "validationLabel": "Status pemberi kuasa",
      "required": true,
      "options": [
        { "value": "Wajib Pajak", "label": "Wajib Pajak" },
        { "value": "Wakil Wajib Pajak", "label": "Wakil Wajib Pajak:" }
      ]
    },
    {
      "type": "conditional",
      "className": "indent",
      "when": { "group": "statusPemberi", "value": "Wakil Wajib Pajak" },
      "fields": [
        {
          "id": "namaWpDiwakili",
          "label": "nama",
          "validationLabel": "Nama Wajib Pajak yang diwakili",
          "type": "text",
          "required": true
        },
        {
          "id": "npwpWpDiwakili",
          "label": "NPWP",
          "validationLabel": "NPWP Wajib Pajak yang diwakili",
          "type": "npwp",
          "placeholder": "16 digit NPWP",
          "required": true
        }
      ]
    },
    {
      "type": "paragraph",
      "variant": "section",
      "text": "dengan ini memberikan kuasa khusus kepada: *)"
    },
    {
      "type": "radio",
      "name": "statusKuasa",
      "label": "",
      "validationLabel": "Jenis penerima kuasa",
      "required": true,
      "options": [
        { "value": "Konsultan Pajak", "label": "Konsultan Pajak" },
        { "value": "Pihak Lain", "label": "Pihak Lain" },
        { "value": "Keluarga Wajib Pajak", "label": "keluarga Wajib Pajak," }
      ]
    },
    {
      "type": "fields",
      "className": "indent",
      "fields": [
        {
          "id": "namaKuasa",
          "label": "nama",
          "validationLabel": "Nama penerima kuasa",
          "type": "text",
          "required": true
        },
        {
          "id": "npwpKuasa",
          "label": "NPWP",
          "validationLabel": "NPWP penerima kuasa",
          "type": "npwp",
          "placeholder": "16 digit NPWP",
          "required": true
        }
      ]
    },
    {
      "type": "conditional",
      "className": "indent",
      "clearWhenHidden": true,
      "when": { "group": "statusKuasa", "value": "Konsultan Pajak" },
      "fields": [
        {
          "id": "izinKonsultan",
          "label": "Nomor Izin Konsultan",
          "validationLabel": "Nomor Izin Konsultan",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "type": "conditional",
      "className": "indent",
      "clearWhenHidden": true,
      "when": { "group": "statusKuasa", "value": "Pihak Lain" },
      "fields": [
        {
          "id": "nomorSkt",
          "label": "SKT",
          "validationLabel": "SKT",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "type": "conditional",
      "className": "indent",
      "clearWhenHidden": true,
      "when": { "group": "statusKuasa", "value": "Keluarga Wajib Pajak" },
      "fields": [
        {
          "id": "hubunganKeluarga",
          "label": "status hubungan keluarga",
          "validationLabel": "Status hubungan keluarga",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "type": "inline-sentence",
      "segments": [
        { "type": "text", "value": "untuk melaksanakan hak dan/atau memenuhi kewajiban perpajakan terkait " },
        {
          "type": "field",
          "field": {
            "id": "ruangLingkup",
            "label": "Hak dan/atau kewajiban perpajakan yang dikuasakan",
            "type": "text",
            "className": "inline-field wide",
            "required": true
          }
        },
        { "type": "text", "value": " berkenaan dengan jenis pajak " },
        {
          "type": "field",
          "field": {
            "id": "jenisPajak",
            "label": "Jenis pajak",
            "type": "text",
            "className": "inline-field",
            "required": true
          }
        },
        {
          "type": "select",
          "field": {
            "id": "jenisPeriodePajak",
            "label": "Jenis periode pajak",
            "className": "inline-field period-type-select",
            "placeholder": "Pilih periode",
            "required": true,
            "options": [
              { "value": "Masa Pajak", "label": "Masa Pajak" },
              { "value": "Bagian Tahun Pajak", "label": "Bagian Tahun Pajak" },
              { "value": "Tahun Pajak", "label": "Tahun Pajak" }
            ]
          }
        },
        {
          "type": "field",
          "field": {
            "id": "periodePajak",
            "label": "Periode pajak",
            "type": "text",
            "className": "inline-field",
            "placeholder": "Contoh: Juli 2026",
            "required": true
          }
        },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "validity",
      "prefix": "Surat Kuasa Khusus ini berlaku mulai tanggal",
      "middle": "sampai dengan tanggal",
      "start": { "id": "mulaiBerlaku", "label": "Tanggal mulai berlaku", "required": true },
      "end": { "id": "akhirBerlaku", "label": "Tanggal berakhir", "required": true }
    },
    {
      "type": "paragraph",
      "variant": "section",
      "text": "Untuk keperluan tersebut, penerima kuasa dikuasakan untuk:"
    },
    {
      "type": "repeatable",
      "id": "tujuanKuasa",
      "label": "Tujuan atau tindakan yang dikuasakan",
      "placeholder": "Tuliskan tujuan atau tindakan yang dikuasakan",
      "min": 1,
      "max": 20,
      "required": true,
      "addLabel": "+ Tambah tujuan kuasa",
      "removeLastLabel": "− Hapus tujuan terakhir"
    },
    {
      "type": "paragraph",
      "text": "Dengan ini, pemberi kuasa menyatakan bahwa dalam hal hak dan/atau kewajiban perpajakan yang dikuasakan dilakukan secara elektronik, penerima kuasa berhak untuk mengakses akun elektronik pemberi kuasa pada sistem elektronik Direktorat Jenderal Pajak."
    },
    {
      "type": "paragraph",
      "text": "Demikian surat kuasa khusus ini dibuat untuk dipergunakan sebagaimana mestinya."
    },
    {
      "type": "signature-pair",
      "left": {
        "roleText": "Penerima kuasa,",
        "nameField": {
          "id": "namaTtdKuasa",
          "label": "Nama penerima kuasa pada tanda tangan",
          "placeholder": "Nama lengkap penerima kuasa",
          "required": true
        }
      },
      "right": {
        "roleText": "Pemberi kuasa,",
        "showStampOnScreen": true,
        "nameField": {
          "id": "namaTtdPemberi",
          "label": "Nama pemberi kuasa pada tanda tangan",
          "placeholder": "Nama lengkap pemberi kuasa",
          "required": true
        }
      }
    }
  ],
  "syncNames": [
    { "source": "namaPemberi", "target": "namaTtdPemberi" },
    { "source": "namaKuasa", "target": "namaTtdKuasa" }
  ]
}
