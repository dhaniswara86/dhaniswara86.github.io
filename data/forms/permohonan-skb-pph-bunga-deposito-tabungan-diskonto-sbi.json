{
  "schemaVersion": 1,
  "id": "permohonan-skb-pph-bunga-deposito-tabungan-diskonto-sbi",
  "type": "letter",
  "renderer": "letter-classic",
  "title": "Permohonan SKB PPh Bunga Deposito, Tabungan, dan Diskonto SBI",
  "description": "Formulir interaktif permohonan Surat Keterangan Bebas Pemotongan Pajak Penghasilan atas bunga deposito dan tabungan serta diskonto Sertifikat Bank Indonesia bagi Dana Pensiun.",
  "notice": "Isi identitas penandatangan dan Dana Pensiun, dasar pengesahan, nama bank, centang seluruh pernyataan, lalu isi tempat/tanggal dan nama penandatangan. Data hanya diproses pada perangkat Anda.",
  "formTitle": "",
  "layout": {
    "showFormTitle": false,
    "paper": "A4",
    "orientation": "portrait",
    "style": "letter-classic",
    "fieldLayout": {
      "labelWidthMm": 31,
      "colonWidthMm": 4
    }
  },
  "blocks": [
    {
      "type": "fields",
      "fields": [
        {
          "id": "nomor",
          "label": "Nomor",
          "type": "text",
          "required": true
        },
        {
          "id": "lampiran",
          "label": "Lampiran",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "type": "staticField",
      "label": "Hal",
      "text": "Permohonan Surat Keterangan Bebas Pemotongan Pajak Penghasilan atas Bunga Deposito dan Tabungan serta Diskonto Sertifikat Bank Indonesia"
    },
    {
      "type": "inlineField",
      "prefix": "Yth. Kepala Kantor Pelayanan Pajak ",
      "field": {
        "id": "kpp",
        "label": "Nama Kantor Pelayanan Pajak",
        "type": "text",
        "required": true
      }
    },
    {
      "type": "paragraph",
      "text": "Yang bertanda tangan di bawah ini:"
    },
    {
      "type": "fields",
      "indent": true,
      "fields": [
        {
          "id": "namaPenandatangan",
          "label": "Nama",
          "type": "text",
          "required": true
        },
        {
          "id": "npwpPenandatangan",
          "label": "NPWP",
          "validationLabel": "NPWP penandatangan",
          "type": "text",
          "inputMode": "numeric",
          "required": true
        },
        {
          "id": "jabatan",
          "label": "Jabatan",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "type": "choice",
      "id": "status",
      "label": "Bertindak selaku *)",
      "selection": "single",
      "required": true,
      "display": "checkbox-style-radio",
      "options": [
        {
          "value": "Wajib Pajak",
          "label": "Wajib Pajak"
        },
        {
          "value": "Wakil",
          "label": "Wakil"
        },
        {
          "value": "Kuasa",
          "label": "Kuasa, dari Wajib Pajak"
        }
      ]
    },
    {
      "type": "fields",
      "indent": true,
      "fields": [
        {
          "id": "namaWp",
          "label": "Nama",
          "type": "text",
          "required": true
        },
        {
          "id": "npwpWp",
          "label": "NPWP",
          "validationLabel": "NPWP Wajib Pajak",
          "type": "text",
          "inputMode": "numeric",
          "required": true
        },
        {
          "id": "alamatWp",
          "label": "Alamat",
          "type": "textarea",
          "rows": 2,
          "required": true
        },
        {
          "id": "klu",
          "label": "KLU",
          "type": "text",
          "required": true
        },
        {
          "id": "nomorPengesahan",
          "label": "Nomor KMK/KDK OJK **)",
          "type": "text",
          "required": true
        },
        {
          "id": "tanggalPengesahan",
          "label": "Tanggal KMK/KDK OJK **)",
          "type": "text",
          "placeholder": "Contoh: 17 Juli 2026",
          "required": true
        }
      ]
    },
    {
      "type": "inlineField",
      "prefix": "mengajukan permohonan untuk memperoleh Surat Keterangan Bebas Pemotongan Pajak Penghasilan atas Bunga Deposito dan Tabungan serta Diskonto Sertifikat Bank Indonesia, yang ditempatkan pada atau diterbitkan oleh Bank ",
      "field": {
        "id": "namaBank",
        "label": "Nama bank",
        "type": "text",
        "required": true
      },
      "suffix": "."
    },
    {
      "type": "checklist",
      "requiredAll": true,
      "items": [
        {
          "id": "pernyataanSumberDana",
          "required": true,
          "text": "Dana yang ditempatkan tersebut di atas diperoleh dari sumber pendapatan sebagaimana dimaksud dalam Pasal 29 Undang-Undang Nomor 11 Tahun 1992 tentang Dana Pensiun dan perubahannya."
        },
        {
          "id": "pernyataanLaporanOjk",
          "required": true,
          "text": "Kami menyatakan bahwa kami telah menyampaikan Laporan Berkala Dana Pensiun kepada Otoritas Jasa Keuangan."
        },
        {
          "id": "pernyataanRisiko",
          "required": true,
          "text": "Apabila data yang kami sampaikan dalam permohonan ini tidak benar, kami bersedia menanggung segala risiko dan sanksi sesuai dengan ketentuan perundang-undangan."
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "Demikian permohonan ini kami sampaikan."
    },
    {
      "type": "signatureCustom",
      "align": "right",
      "placeDateField": {
        "id": "tempatTanggal",
        "label": "Tempat dan tanggal",
        "type": "text",
        "placeholder": "Contoh: Bandung, 17 Juli 2026",
        "required": true
      },
      "roleText": "Wajib Pajak/Wakil/Kuasa ***)",
      "roleSource": "status",
      "nameField": {
        "id": "namaTtd",
        "label": "Nama lengkap penandatangan",
        "type": "text",
        "placeholder": "Nama lengkap penandatangan",
        "required": true
      },
      "signatureSpaceMm": 22
    },
    {
      "type": "footnote",
      "text": "*) Beri tanda (√) pada kotak yang disediakan sesuai dengan pihak yang mengajukan permohonan."
    },
    {
      "type": "footnote",
      "text": "**) Berdasarkan pengesahan pendirian Dana Pensiun."
    },
    {
      "type": "footnote",
      "text": "***) Coret yang tidak perlu."
    }
  ],
  "logic": {
    "syncRules": [
      {
        "when": {
          "field": "status",
          "equals": "Wajib Pajak"
        },
        "copy": [
          {
            "source": "namaPenandatangan",
            "target": "namaWp"
          },
          {
            "source": "npwpPenandatangan",
            "target": "npwpWp"
          }
        ],
        "mode": "live"
      },
      {
        "source": "namaPenandatangan",
        "target": "namaTtd",
        "mode": "until-target-manual-edit"
      },
      {
        "source": "status",
        "target": "signatureRole",
        "mode": "display"
      }
    ],
    "validation": {
      "requiredFields": [
        "nomor",
        "lampiran",
        "kpp",
        "namaPenandatangan",
        "npwpPenandatangan",
        "jabatan",
        "namaWp",
        "npwpWp",
        "alamatWp",
        "klu",
        "nomorPengesahan",
        "tanggalPengesahan",
        "namaBank",
        "tempatTanggal",
        "namaTtd"
      ],
      "requiredChoiceGroups": [
        "status"
      ],
      "requiredChecks": [
        "pernyataanSumberDana",
        "pernyataanLaporanOjk",
        "pernyataanRisiko"
      ],
      "onInvalid": {
        "mode": "confirm-continue",
        "messageTemplate": "Masih ada {count} bagian yang belum diisi atau dicentang. Tetap lanjut mencetak?"
      }
    },
    "reset": {
      "confirm": true,
      "message": "Kosongkan seluruh isi formulir?",
      "resetManualOverrides": [
        "namaTtd"
      ]
    }
  },
  "guide": [
    {
      "title": "Identitas dan dasar pengesahan Dana Pensiun",
      "text": "Isi identitas penandatangan dan Wajib Pajak, KLU, serta nomor dan tanggal surat pengesahan pendirian Dana Pensiun oleh Menteri Keuangan atau keputusan OJK."
    },
    {
      "title": "Nama bank dan pernyataan",
      "text": "Isi nama bank tempat dana ditempatkan atau yang menerbitkan instrumen, kemudian centang ketiga pernyataan sesuai keadaan sebenarnya."
    },
    {
      "title": "Tanda tangan",
      "text": "Isi tempat dan tanggal permohonan serta nama lengkap Wajib Pajak, Wakil, atau Kuasa yang menandatangani."
    }
  ],
  "sourceMigration": {
    "sourceType": "standalone-html",
    "preserveFieldIds": true,
    "notes": "Model mempertahankan ID field dan logic utama dari HTML sumber agar migrasi ke Form Engine Kabayan dapat dilakukan tanpa mengubah makna formulir."
  }
}
